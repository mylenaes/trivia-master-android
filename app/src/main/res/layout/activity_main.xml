<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brancoFundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!--Ícone do app-->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_icone_app"
            android:elevation="6dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ideia"
                android:contentDescription="@string/app_name">
            </ImageView>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/azulPrincipal"
            android:textSize="34sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/txtSubtituloInicio"
            android:textColor="@color/cinza"
            android:textSize="16sp">
        </TextView>

        <!--Aviso de sem conexão (aparece pelo ConnectivityReceiver)-->
        <TextView
            android:id="@+id/tvSemConexao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_opcao_incorreta"
            android:padding="12dp"
            android:gravity="center"
            android:text="@string/txtSemConexao"
            android:textColor="@color/vermelho"
            android:textSize="14sp"
            android:visibility="gone">
        </TextView>

        <!--Nome-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/txtSeuNome"
            android:textColor="@color/azulPrincipal"
            android:textSize="14sp"
            android:textStyle="bold">
        </TextView>

        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_opcao"
            android:paddingHorizontal="18dp"
            android:hint="@string/hintNome"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="20"
            android:maxLines="1"
            android:textColor="@color/azulPrincipal"
            android:textColorHint="@color/cinza"
            android:textSize="16sp">
        </EditText>

        <!--Buttons-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComecar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:text="@string/btnComecar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/azulSecundario"
            app:cornerRadius="20dp">
        </com.google.android.material.button.MaterialButton>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistorico"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/btnHistorico"
            android:textAllCaps="false"
            android:textColor="@color/azulPrincipal"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/branco"
            app:strokeColor="@color/brancoAzulado"
            app:strokeWidth="2dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_historico"
            app:iconTint="@color/azulPrincipal"
            app:iconGravity="textStart"
            app:iconPadding="8dp">
        </com.google.android.material.button.MaterialButton>

    </LinearLayout>

</ScrollView>
