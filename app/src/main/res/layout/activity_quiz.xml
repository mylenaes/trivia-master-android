<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brancoFundo">

    <!--Header-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:orientation="vertical"
        android:background="@color/azulPrincipal"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="40dp">

            <TextView
                android:id="@+id/tvNumeroQuestao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txtNumeroQuestao"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/tvPontuacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txtPontuacao"
                android:textColor="@color/branco"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pontuacao"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">
            </TextView>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressoQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/azulSecundario"
            android:progressBackgroundTint="#62748E">
        </ProgressBar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/txtCategoria"
                android:textColor="@color/cinza"
                android:textSize="16sp"
                android:layout_marginRight="20dp">
            </TextView>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_circulo"
                android:text="@string/txtTempo"
                android:textColor="@color/azulPrincipal"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>

        </LinearLayout>

    </LinearLayout>

    <!--Question Area-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!--Question-->
            <TextView
                android:id="@+id/tvQuestao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_enunciado"
                android:padding="24dp"
                android:text="@string/txtEnunciado"
                android:textColor="@color/azulPrincipal"
                android:textSize="22sp"
                android:textStyle="bold">
            </TextView>

            <!--Option A-->
            <LinearLayout
                android:id="@+id/opcaoA"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_opcao"
                android:padding="18dp"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circulo"
                    android:text="@string/a"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="16sp">
                </TextView>
                
                <TextView
                    android:id="@+id/tvOpcaoA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/opcaoA"
                    android:textSize="20sp"
                    android:textColor="@color/azulPrincipal">
                </TextView>

            </LinearLayout>
            
            <!--Option B-->
            <LinearLayout
                android:id="@+id/opcaoB"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_opcao"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">
                
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circulo"
                    android:text="@string/b"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="16sp">
                </TextView>
                
                <TextView
                    android:id="@+id/tvOpcaoB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/opcaoB"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="20sp">
                </TextView>

            </LinearLayout>

            <!--Option C-->
            <LinearLayout
                android:id="@+id/opcaoC"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_opcao"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">
                
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circulo"
                    android:text="@string/c"
                    android:textSize="16sp"
                    android:textColor="@color/azulPrincipal">
                </TextView>
                
                <TextView
                    android:id="@+id/tvOpcaoC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/opcaoC"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="20sp">
                </TextView>

            </LinearLayout>

            <!--Option D-->
            <LinearLayout
                android:id="@+id/opcaoD"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_opcao"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">
                
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circulo"
                    android:text="@string/d"
                    android:textSize="16sp"
                    android:textColor="@color/azulPrincipal">
                </TextView>
                
                <TextView
                    android:id="@+id/tvOpcaoD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/opcaoD"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="20sp">
                </TextView>
                
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!--Feedback-->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text=""
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone">
    </TextView>

    <!--Button-->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnProximo"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/btnProximo"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/bg_seletor_botao"
        android:backgroundTint="@null"
        android:enabled="false">
    </androidx.appcompat.widget.AppCompatButton>
    
</LinearLayout>