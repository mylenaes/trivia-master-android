<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brancoFundo">

    <LinearLayout
        android:id="@+id/cabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/azulPrincipal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnVoltarTopo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_voltar"
            android:contentDescription="@string/return_button_description">
        </ImageButton>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/txtNovaPartida"
            android:textColor="@color/branco"
            android:textSize="22sp"
            android:textStyle="bold">
        </TextView>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--Categoria-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txtEscolhaCategoria"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="14sp">
                </TextView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp">

                    <Spinner
                        android:id="@+id/spCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_campo"
                        android:paddingStart="8dp"
                        android:paddingEnd="40dp">
                    </Spinner>

                    <!--setinha, porque o fundo próprio do Spinner tira a original-->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_seta_baixo"
                        app:tint="@color/azulPrincipal"
                        android:importantForAccessibility="no">
                    </ImageView>

                </FrameLayout>

            </LinearLayout>

            <!--Dificuldade-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txtEscolhaDificuldade"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="14sp">
                </TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnFacil"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="@string/txtFacil"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                    <TextView
                        android:id="@+id/btnMedio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="@string/txtMedio"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                    <TextView
                        android:id="@+id/btnDificil"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="@string/txtDificil"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                </LinearLayout>

            </LinearLayout>

            <!--Quantidade-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txtEscolhaQuantidade"
                    android:textColor="@color/azulPrincipal"
                    android:textSize="14sp">
                </TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnQtd5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                    <TextView
                        android:id="@+id/btnQtd10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="10"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                    <TextView
                        android:id="@+id/btnQtd15"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:text="15"
                        android:textColor="@color/azulPrincipal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true">
                    </TextView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!--Buttons-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/btnIniciar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/azulSecundario"
        app:cornerRadius="20dp">
    </com.google.android.material.button.MaterialButton>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btnVoltar"
        android:textAllCaps="false"
        android:textColor="@color/azulPrincipal"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/branco"
        app:strokeColor="@color/brancoAzulado"
        app:strokeWidth="2dp"
        app:cornerRadius="20dp">
    </com.google.android.material.button.MaterialButton>

</LinearLayout>
